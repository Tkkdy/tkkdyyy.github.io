---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {getEditorialStories} from '../../../lib/admin/stories';
import '../../../styles/admin-photos.css';
const stories=await getEditorialStories();
---
<AdminLayout title="照片" section="照片" active="photos" stories={stories}>
 <section class="stories-view photo-library">
  <header class="stories-heading"><div><h1>照片</h1><p>按相册整理照片，点开即可编辑。</p></div><a class="primary-action" href={`${import.meta.env.BASE_URL}admin/photos/upload/`}>上传新照片</a></header>
  <div class="photo-library-tabs" role="group" aria-label="照片状态"><button type="button" data-photo-tab="published" aria-pressed="true">已上线</button><button type="button" data-photo-tab="drafts" aria-pressed="false">草稿</button></div>
  <p role="status" data-photo-list-message>正在读取照片与私有草稿……</p>
  <div class="photo-list" data-photo-list></div>
 </section>
</AdminLayout>
<script>import {initializePhotoLibrary} from '../../../lib/admin/photos-client';void initializePhotoLibrary();</script>
