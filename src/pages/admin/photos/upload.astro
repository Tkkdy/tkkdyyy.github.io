---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PhotoAlbums from '../../../components/images/PhotoAlbums.astro';
import {getEditorialStories} from '../../../lib/admin/stories';
import '../../../styles/admin-photos.css';
const stories=await getEditorialStories();
---
<AdminLayout title="照片编辑" section="照片" active="photos" stories={stories}>
 <section class="stories-view photo-batch" data-photo-batch>
  <header class="stories-heading"><div><h1>把这一组照片留下来</h1><p>地点、日期和说明整组填一次。点照片，只需选填单张说明。</p></div><a href={`${import.meta.env.BASE_URL}admin/photos/`}>返回照片</a></header>
  <label class="photo-upload"><span>选择照片 <small>可一次多选</small></span><input type="file" multiple accept="image/*" data-batch-files /><small>每张原图最多 50 MB，一组最多 20 张。保存前自动压缩并去除定位信息。</small></label>
  <section class="batch-group-settings" aria-label="整组照片信息">
   <label>相册名称<input data-batch-album-name data-group-field="series" maxlength="120" placeholder="给这一组起个名字" /></label>
   <label>整组说明<textarea data-group-field="alt" maxlength="240" rows="2" placeholder="这组照片里有什么，或你想记下的一句话"></textarea></label>
   <div class="batch-group-extra"><label>地点（选填）<input data-group-field="location" maxlength="160" placeholder="例如：金沙公园" /></label><label>拍摄日期（选填）<input type="date" data-group-field="capturedAt" /></label></div>
   <details class="batch-group-more"><summary>更多设置</summary><div class="batch-group-extra"><label>相纸白边展示<select data-group-field="frameDisplay"><option value="information">照片说明</option><option value="date">拍摄日期</option><option value="description">物品描述（使用说明文字）</option></select></label></div></details>
   <p data-group-mixed hidden>这组原有信息不完全相同。修改某一项时，会统一应用到本组；未修改的项目保持原样。</p>
   <datalist id="photo-album-names"></datalist>
   <p class="batch-group-note">修改会自动保存到草稿，单张说明会保留。准备好后再发布更新。</p>
  </section>
  <section class="photo-publications" data-photo-publications hidden aria-labelledby="photo-publications-title">
   <h2 id="photo-publications-title">发布进度</h2><p>照片提交后，会依次检查、合并，再更新两站。这里会显示卡在哪一步。</p><div data-photo-publication-list></div>
  </section>
  <p role="status" data-batch-message>正在读取……</p>
  <div class="batch-grid-heading"><h2>这一组照片</h2><div><button type="button" data-batch-select-all>全选</button><button type="button" data-batch-select-none>全不选</button></div></div>
  <div class="photo-batch-list" data-batch-list></div>
  <div class="photo-batch-actions"><div><p data-batch-summary>尚未选择照片</p><small>未选中的照片会保留为私有草稿。</small></div><button type="button" data-batch-publish disabled>预览并发布</button></div>
  <dialog class="photo-sheet" data-photo-sheet aria-labelledby="photo-sheet-title">
   <header class="photo-sheet-heading"><img data-photo-sheet-image alt="" /><div><h2 id="photo-sheet-title">这张照片</h2><p data-photo-sheet-name></p></div></header>
   <div class="photo-sheet-body" data-photo-sheet-body></div>
   <footer class="photo-sheet-footer"><p role="status" data-photo-sheet-message>其余信息继承整组设置，备注可以留空。</p><button type="button" data-photo-sheet-done autofocus>完成</button><button type="button" data-photo-sheet-return hidden>保留修改，返回列表</button></footer>
  </dialog>
  <dialog class="batch-review" data-batch-review aria-labelledby="batch-review-title">
   <header class="batch-review-heading"><div><h2 id="batch-review-title">发布前，再看一眼</h2><p data-batch-review-summary></p></div><button type="button" data-batch-review-close>返回修改</button></header>
   <PhotoAlbums livePreview={true} />
   <footer class="batch-review-actions"><span>仅包含你选中的照片；确认后才会提交发布。</span><button type="button" data-batch-confirm>确认发布</button></footer>
  </dialog>
 </section>
</AdminLayout>
<script>import {initializePhotoBatch} from '../../../lib/admin/photo-batch-client';void initializePhotoBatch();</script>
