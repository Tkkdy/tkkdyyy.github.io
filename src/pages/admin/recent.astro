---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {getEditorialStories} from '../../lib/admin/stories';
const stories=await getEditorialStories();
---
<AdminLayout title="近况" section="近况" active="recent" stories={stories}>
 <section class="site-settings stories-view" data-settings-scope="recent">
  <header class="stories-heading"><div><h1>最近在做什么</h1><p>首页的三行近况。每一项都可以留空，留空后不显示。</p></div></header>
  <p role="status" data-settings-message>正在读取近况……</p>
  <form data-settings-form hidden>
   <label>在做什么<textarea name="doing" maxlength="240" rows="3" placeholder="写下你愿意公开的近况"></textarea></label>
   <label>在听什么<input name="listening" maxlength="240" /></label>
   <label>在想什么<textarea name="thinking" maxlength="240" rows="3"></textarea></label>
   <p>修改会自动保存为私有草稿；点击发布后创建提案，通过既有 CI 与合并流程更新两站。</p>
   <div class="settings-actions"><button type="button" data-settings-save>保存私有草稿</button><button type="button" data-settings-preview>预览首页近况</button><button type="submit">发布近况</button><button type="button" data-settings-download>下载备份</button></div>
  </form>
  <section data-settings-preview-body hidden aria-label="未发布的近况预览"></section>
 </section>
</AdminLayout>
<script>import {initializeSiteSettings} from '../../lib/admin/site-settings-client';void initializeSiteSettings();</script>
<style>.site-settings{max-width:780px}.site-settings p{line-height:1.8;margin:18px 0;color:#65726b}.site-settings label{display:grid;gap:10px;margin:24px 0}.site-settings input,.site-settings textarea{width:100%;padding:14px;font:inherit;font-size:16px;line-height:1.7;border:1px solid #d0d7d1;border-radius:8px;background:white}.settings-actions{display:flex;flex-wrap:wrap;gap:12px}.settings-actions button{min-height:44px;padding:10px 18px;border:1px solid #b8c7bd;border-radius:6px;background:white}.settings-actions [type=submit]{background:#315c48;color:white}.site-settings [data-settings-preview-body]{margin-top:28px;padding:24px;background:#eeeae0;border-radius:10px;white-space:pre-wrap;overflow-wrap:anywhere}.site-settings [hidden]{display:none!important}</style>
