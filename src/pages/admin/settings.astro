---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getEditorialStories } from '../../lib/admin/stories';
const stories = await getEditorialStories();
---
<AdminLayout title="最近与音乐" section="站点设置" active="settings" stories={stories}>
  <section class="site-settings stories-view">
    <h1>最近与音乐</h1>
    <p>留空的近况不会显示。私有草稿保存后，可预览并发起发布提案；正式站在审核与发布完成后更新。</p>
    <p role="status" data-settings-message>正在读取受保护的站点设置……</p>
    <form data-settings-form hidden>
      <fieldset><legend>最近</legend><label>在做什么<textarea name="doing" maxlength="240" rows="2"></textarea></label><label>在听什么<textarea name="listening" maxlength="240" rows="2"></textarea></label><label>在想什么<textarea name="thinking" maxlength="240" rows="2"></textarea></label></fieldset>
      <fieldset><legend>关于页音乐卡</legend><label>歌曲名<input name="title" maxlength="240" /></label><label>歌手（可留空）<input name="artist" maxlength="240" /></label><label>一句短话<textarea name="note" maxlength="240" rows="2"></textarea></label><label>已授权音源 / 合法平台链接<input name="source" maxlength="2048" /></label><small>接受 HTTPS 平台链接、经授权的直接音频链接或已审核的站内音频路径；无来源时保留文字卡。本页不上传音乐。</small></fieldset>
      <div class="settings-actions"><button type="button" data-settings-save>保存私有草稿</button><button type="button" data-settings-preview>预览</button><button type="submit">发起发布提案</button><button type="button" data-settings-download>下载备份</button></div>
    </form>
    <section data-settings-preview-body hidden aria-label="未发布的内容预览"></section>
  </section>
</AdminLayout>
<script>
  import { initializeSiteSettings } from '../../lib/admin/site-settings-client';
  void initializeSiteSettings();
</script>
<style>
.site-settings{max-width:780px}.site-settings h1{font-size:26px}.site-settings p{line-height:1.8;margin-block:16px}.site-settings fieldset{border:1px solid #d8d7d1;margin:24px 0;padding:20px}.site-settings label{display:grid;gap:8px;margin:16px 0;font-size:14px}.site-settings input,.site-settings textarea{width:100%;font:inherit;font-size:16px;padding:10px;border:1px solid #ccd4d0;border-radius:4px;background:white}.site-settings small{line-height:1.8}.settings-actions{display:flex;flex-wrap:wrap;gap:12px}.settings-actions button{min-height:44px;padding:10px;font:inherit;border:1px solid #bbc9c1;border-radius:4px;background:white}.site-settings [data-settings-preview-body]{border-top:1px solid #ccd4d0;margin-top:32px;padding-top:20px;white-space:pre-wrap;overflow-wrap:anywhere}.site-settings [hidden]{display:none!important}
</style>
