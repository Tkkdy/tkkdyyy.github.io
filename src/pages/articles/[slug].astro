---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { withBase } from '../../lib/site-url';
import { formatArticleDate, getPublishedArticles } from '../../lib/content/articles';
import ContentTaxonomy from '../../components/ContentTaxonomy.astro';
import StoryBody from '../../components/content/StoryBody.astro';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
---

<ArticleLayout
  title={`${data.title} — tkkdy`}
  description={data.description}
  ogType="article"
  bodyClass="article-detail-body-page"
>
  <article class="article-detail">
    <header class="article-detail-header">
      <h1 class="article-detail-title">{data.title}</h1>

      <div class="article-detail-meta">
        <time datetime={data.publishedAt.toISOString().slice(0, 10)}>
          {formatArticleDate(data.publishedAt)}
        </time>
        {data.readingTime !== undefined && <span>{data.readingTime} min read</span>}
        {data.categories && data.categories.length > 0 && <span>{data.categories.join(' / ')}</span>}
      </div>
    </header>

    <StoryBody variant="prose" markdown={article.body}>
      <ContentTaxonomy categories={data.categories} tags={data.tags} />

      <div class="article-ending-mark" aria-hidden="true">· · ·</div>
      <nav class="article-ending" aria-label="文章结束" data-pagefind-ignore>
        <a href={withBase('articles/')}>Close Book</a>
      </nav>
    </StoryBody>
  </article>
</ArticleLayout>
