---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {
  formatArticleDate,
  formatPublishNumber,
  getPublishedArticles,
} from '../../lib/content/articles';
import { withBase } from '../../lib/site-url';
import { taxonomyHref } from '../../lib/content/taxonomy';

const articles = await getPublishedArticles();
---

<ArticleLayout title="Articles — tkkdy" bodyClass="articles-list-body">
  <section class="articles-page" aria-labelledby="articles-title">
    <header class="articles-page-header">
      <h1 id="articles-title" class="articles-page-title">Articles.</h1>
      <div class="articles-page-rule" aria-hidden="true"></div>
    </header>

    <div class="article-list">
      {
        articles.map((article) => (
          <article class="article-row">
            <time
              class="article-row-date"
              datetime={article.data.publishedAt.toISOString().slice(0, 10)}
            >
              {formatArticleDate(article.data.publishedAt)}
            </time>

            <h2 class="article-row-title">
              <a href={withBase(`articles/${article.data.slug}/`)}>{article.data.title}</a>
            </h2>

            <p class="article-row-desc">{article.data.description}</p>

            <div class="article-row-meta">
              <div class="article-row-trace">
                <span class="article-row-number">
                  {formatPublishNumber(article.data.publishNumber!)}
                </span>
                {article.data.categories && article.data.categories.length > 0 && (
                  <span class="article-row-domain">
                    {article.data.categories.map((category) => (
                      <a href={withBase(taxonomyHref('categories', category))}>{category}</a>
                    ))}
                  </span>
                )}
              </div>

              {article.data.tags && article.data.tags.length > 0 && (
                <ul class="article-row-tags" aria-label="标签">
                  {article.data.tags.map((tag) => (
                    <li><a href={withBase(taxonomyHref('tags', tag))}>{tag}</a></li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</ArticleLayout>
