---
// 影像栏目 /images
// 编辑式摄影档案流：横 / 竖 / 方图按原比例交错，而不是统一卡片网格。
import WindowPhoto from '../../components/WindowPhoto.astro';
import ImageLayout from '../../layouts/ImageLayout.astro';
import PhotoAlbums from '../../components/images/PhotoAlbums.astro';
import {
  getPublishedImages,
  imageFileExists,
} from '../../lib/content/images';
import { withBase } from '../../lib/site-url';

const images = await getPublishedImages();
---

<ImageLayout title="影像 — tkkdy" bodyClass="images-page-body">
  <section class="images-page" aria-labelledby="images-title">
    <header class="images-page-header">
      <p class="images-kicker">Visual Journal</p>
      <h1 id="images-title" class="images-page-title">Images.</h1>
      <p class="images-page-lead">
        一些时刻，独自停留；一些故事，叠放在一起。点开一组照片，慢慢看。
      </p>
    </header>

    <WindowPhoto compact />

    <PhotoAlbums photos={images.map(image=>({id:image.id,...image.data,image:withBase(image.data.image),hasFile:imageFileExists(image.data.image),href:withBase(`images/${image.data.slug}/`)}))} />
  </section>
</ImageLayout>
