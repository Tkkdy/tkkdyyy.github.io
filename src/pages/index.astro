---
// tkkdy 首页 — v0.2.6 工程化迁移（Stage 1）+ 内容数据化（Stage 2）
// 基于已确认首页布局，使用真实策展内容与可选封面。
// 首页具体内容来自 Content Collections（Markdown），经 homepage.ts 查询层获取。
// 首页样式仅在 body.home / .home-refined 生效，不影响子页面。
import WindowPhoto from '../components/WindowPhoto.astro';
import RecentNotes from '../components/RecentNotes.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import FeaturedSection from '../components/FeaturedSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import EssaysFragmentsSection from '../components/EssaysFragmentsSection.astro';
import PhotographySection from '../components/PhotographySection.astro';

import { getHomepageContent } from '../lib/content/homepage';
import { getPublishedEssays } from '../lib/content/essays';

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/home-refinements.css';

const { articles, essays, fragments, images, projects } = await getHomepageContent();
const featured = essays.find((entry) => entry.data.featured) ?? articles[0];
const featuredImage = featured?.data.slug === 'ai'
  ? images.find((image) => image.data.series === '东海岸日出' && image.data.albumCover)
  : undefined;
const remainingEssays = (await getPublishedEssays())
  .filter((entry) => entry.data.slug !== featured?.data.slug)
  .slice(0, 3);
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title="tkkdy" />

    <!--
      字体：与 v0.2.6 原型一致，临时沿用 Google Fonts 在线加载。
      未下载或提交任何字体文件；后续如需自托管再另行决策。
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500&family=Noto+Serif+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="home home-refined">
    <Header />
    <main>
      <section class="home-intro" aria-label="网站介绍">
        <p class="home-intro-kicker">TKKDY · PERSONAL WEBSITE</p>
        <p class="home-intro-line">一个记录技术、想法与日常的个人网站。</p>
      </section>
      <WindowPhoto />
      <RecentNotes />
      <!-- 空状态保护（CONTENT_MODEL §12）：对应 Collection 没有首页内容时隐藏区块而不是崩溃。
           没有封面时使用文字排版，不生成占位图。 -->
      {featured && <FeaturedSection article={featured} image={featuredImage} />}
      {projects[0] && <ProjectsSection projects={projects} />}
      {remainingEssays[0] && fragments[0] && (
        <EssaysFragmentsSection essays={remainingEssays} fragments={fragments} />
      )}
      {images.length > 0 && <PhotographySection images={images} />}
    </main>
    <Footer />
  </body>
</html>
