---
// 关于页 /about
// 固定站点页面（不需要 Content Collection）。
// 内容全部来自项目中已有的公开信息（PRODUCT.md / 首页与页脚文案），
// 只使用公开身份 VDVXDV，不虚构任何个人信息。
// 当前无真实公开联系方式 URL，因此不显示联系方式区块。
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { withBase } from '../lib/site-url';

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/about.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead title="关于 — VDVXDV" />

    <!--
      字体：与 v0.2.6 原型一致，临时沿用 Google Fonts 在线加载。
      未下载或提交任何字体文件；后续如需自托管再另行决策。
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500&family=Noto+Serif+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main data-pagefind-body>
      <meta name="pagefind-meta" data-pagefind-meta="title: 关于, type: 关于" />
      <section class="about-page">
        <header class="about-page-header">
          <div class="section-header">
            <span>About</span>
            <span>关于</span>
          </div>
          <h1 class="about-page-title">关于</h1>
        </header>

        <div class="about-body">
          <p class="about-lead">
            VDVXDV 是一个属于技术创作者的个人网站。这里是 VDVXDV
            的公开个人空间，记录正在进行的构建、长时间的思考以及沿途捕捉的切片。
          </p>

          <section class="about-section">
            <h2>What I do</h2>
            <p>探索技术与表达的交叉点。网站用于安放长文、项目与一闪而过的念头：</p>
            <ul class="about-list">
              <li><strong>项目</strong> —— 正在构建与实验的产品和工具。</li>
              <li><strong>写作</strong> —— 完整的文章，与相对完整的随笔。</li>
              <li><strong>影像</strong> —— 由单张照片组成的影像流。</li>
            </ul>
          </section>

          <section class="about-section">
            <h2>This site</h2>
            <ul class="about-list">
              <li>
                <a href={withBase('projects/')}>项目 Projects</a> —— 正在进行与实验中的东西。
              </li>
              <li>
                <a href={withBase('articles/')}>文章 Articles</a> —— 结构完整的长内容。
              </li>
              <li>
                <a href={withBase('essays/')}>随笔 Essays</a> —— 较短但相对完整的文字。
              </li>
              <li>
                <a href={withBase('fragments/')}>碎片 Fragments</a> —— 即时、短小的记录。
              </li>
              <li>
                <a href={withBase('images/')}>影像 Images</a> —— 单张照片与其信息。
              </li>
            </ul>
          </section>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
