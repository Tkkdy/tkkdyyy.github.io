---
// 随笔详情页 /essays/[slug]
// 静态生成：只生成 status = published 的随笔。
import EssayLayout from '../../layouts/EssayLayout.astro';
import { withBase } from '../../lib/site-url';
import { getPublishedEssays } from '../../lib/content/essays';
import { formatDate } from '../../lib/content/homepage';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getPublishedEssays();
  return essays.map((essay) => ({
    params: { slug: essay.data.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { data } = essay;
const { Content } = await render(essay);
const hasMedia = Boolean(data.cover);
---

<EssayLayout title={`${data.title} — VDVXDV`} description={data.summary ?? undefined}>
  <article class:list={['essay-detail', hasMedia ? 'essay-detail--image' : 'essay-detail--text']} data-essay-detail>
    <nav class="essay-back-row" aria-label="随笔详情导航">
      <a href={withBase('essays/')}>← 返回随笔</a>
      <span>{hasMedia ? 'IMAGE-LED ESSAY' : 'TEXT-LED ESSAY'}</span>
    </nav>

    <header class:list={['essay-reading-head', hasMedia ? 'essay-image-head' : 'essay-text-head']}>
      <div class="essay-reading-meta">
        <time datetime={formatDate(data.publishedAt)}>{formatDate(data.publishedAt)}</time>
        {data.tags && data.tags.length > 0 && <span>{data.tags.join(' / ')}</span>}
      </div>
      <h1>{data.title}</h1>
      {data.summary && <p class="essay-reading-deck">{data.summary}</p>}
    </header>

    {data.cover && (
      <figure class="essay-lead-cover">
        <img src={withBase(data.cover)} alt={data.coverAlt ?? ''} />
        {data.coverAlt && <figcaption>{data.coverAlt}</figcaption>}
      </figure>
    )}

    <div class="essay-reading-body">
      <div class="essay-reading-prose">
        <Content />
      </div>
      <footer class="essay-reading-ending">
        <span>VDVXDV · ESSAYS</span>
        <a href={withBase('essays/')}>返回随笔归档</a>
      </footer>
    </div>
  </article>
</EssayLayout>
