---
import { siteSettings } from '../lib/content/site-settings';
import '../styles/flavor.css';
const labels = { doing: '在做什么', listening: '在听什么', thinking: '在想什么' };
const rows = Object.entries(siteSettings.recent).filter(([, value]) => value);
---
{rows.length > 0 && <section class="recent-notes" aria-labelledby="recent-heading"><div class="recent-panel"><h2 id="recent-heading"><span>最近</span><small>NOW</small></h2><dl>{rows.map(([key, value]) => <div><dt>{labels[key as keyof typeof labels]}</dt><dd>{value}</dd></div>)}</dl></div></section>}
