---
// 随笔与碎片：浅灰褐色块（#E5E0D8）。
// 随笔与碎片内容来自 Content Collections（essays / fragments）；
// 仅展示现有公开内容，不输出空槽位。
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site-url';
import { formatDate } from '../lib/content/homepage';

interface Props {
  essays: CollectionEntry<'essays'>[];
  fragments: CollectionEntry<'fragments'>[];
}

const { essays, fragments } = Astro.props;
// 各取排序后的第一条（当前首页各只有一条）
const [essay] = essays;
const [fragment] = fragments;
---
<section class="essays-fragments">
  <div class="essays-fragments-inner">
    <div class="essays-fragments-grid">
      <!-- 左：随笔 -->
      <div class="essays-col">
        <div class="section-header essays-header">
          <span>Essays</span>
          <span>随笔</span>
        </div>

        <a class="essay-card group" href={withBase(`essays/${essay.data.slug}/`)}>
          {essay.data.cover && <div class="essay-media"><img src={withBase(essay.data.cover)} alt={essay.data.coverAlt} loading="lazy" /></div>}
          <h3 class="essay-title">{essay.data.title}</h3>
          <p class="essay-summary">{essay.data.summary}</p>
          <div class="essay-date">{formatDate(essay.data.publishedAt)}</div>
        </a>
      </div>

      <!-- 右：碎片堆叠 -->
      <div class="fragments-col">
        <div class="section-header fragments-header">
          <span>Fragments</span>
          <span>碎片</span>
        </div>

        <div class="fragment-stack">
          <!-- 真实碎片（body 为 Markdown 渲染内容；链接到碎片时间流） -->
          <a class="fragment-item" href={withBase('fragments/')}>
            <div class="fragment-date">{formatDate(fragment.data.publishedAt)}</div>
            <div class="fragment-text" set:html={fragment.body} />
          </a>

        </div>
      </div>
    </div>
  </div>
</section>
