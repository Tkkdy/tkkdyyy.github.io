---
// 随笔与碎片：浅灰褐色块（#E5E0D8）。
// 随笔与碎片内容来自 Content Collections（essays / fragments）；
// 无封面时使用纯文字，碎片按已策展条目展示。
import { renderMarkdownBody } from '../lib/content/render-body.mjs';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site-url';
import { formatDate } from '../lib/content/homepage';

interface Props {
  essays: CollectionEntry<'essays'>[];
  fragments: CollectionEntry<'fragments'>[];
}

const { essays, fragments } = Astro.props;


---
<section class="essays-fragments">
  <div class="essays-fragments-inner">
    <div class="essays-fragments-grid">
      <!-- 左：随笔 -->
      <div class="essays-col">
        <div class="section-header essays-header">
          <span>Essays</span>
          <a href={withBase('essays/')}>全部随笔 →</a>
        </div>

        <div class="home-essay-list">
        {essays.map((essay) => <a class="essay-card group" href={withBase(`essays/${essay.data.slug}/`)}>
          {essay.data.cover && <div class="essay-media"><img class="home-cover" src={withBase(essay.data.cover)} alt={essay.data.coverAlt ?? ''} loading="lazy" /></div>}
          <h3 class="essay-title">{essay.data.title}</h3>
          <p class="essay-summary">{essay.data.summary}</p>
          <div class="essay-date">{formatDate(essay.data.publishedAt)}</div>
        </a>)}
        </div>
      </div>

      <!-- 右：碎片堆叠 -->
      <div class="fragments-col">
        <div class="section-header fragments-header">
          <span>Fragments</span>
          <span>碎片</span>
        </div>

        <div class="fragment-stack">
          {fragments.slice(0, 3).map((item) => <a class="fragment-item" href={withBase('fragments/')}>
            <div class="fragment-date">{formatDate(item.data.publishedAt)}</div>
            <div class="fragment-text" set:html={renderMarkdownBody(item.body ?? '')} />
          </a>)}
        </div>
      </div>
    </div>
  </div>
</section>
