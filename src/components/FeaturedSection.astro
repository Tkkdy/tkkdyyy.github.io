---
// 首屏：左侧身份介绍 + 右侧精选随笔（v0.2.6 已批准 5/7 列布局）。
// 真实已发布内容由 index.astro 传入；无封面时采用完整文字布局。
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site-url';
import { formatDate } from '../lib/content/homepage';

interface Props {
  article: CollectionEntry<'articles'> | CollectionEntry<'essays'>;
}

const { article } = Astro.props;
const { data } = article;
---
<section class="hero">
  <div class="hero-grid">
    <!-- 左：身份与介绍（固定 UI，继续硬编码） -->
    <div class="hero-intro">
      <h1 class="hero-title">
        个人项目、<br />
        写作与影像的<br />安静记录。
      </h1>
      <p class="hero-copy">
        探索技术与表达的交叉点。这里是 tkkdy
        的公开个人空间，记录正在进行的构建、长时间的思考以及沿途捕捉的切片。
      </p>
      <div class="hero-links">
        <a class="link-underline" href={withBase('projects/')}>
          查看项目 <span class="arrow">→</span>
        </a>
        <a class="link-underline" href={withBase('articles/')}>
          阅读文章 <span class="arrow">→</span>
        </a>
      </div>
    </div>

    <!-- 右：精选随笔（直角、极简边框） -->
    <div class="featured">
      <div class="section-header featured-header">
        <span>Featured Essay</span>
        <span>精选随笔</span>
      </div>

      <a class:list={["featured-card group", { "featured-text-only": !data.cover }]} href={withBase(`${article.collection}/${article.data.slug}/`)}>
        {data.cover && <div class="featured-media"><img src={withBase(data.cover)} alt={data.coverAlt} /></div>}
        <div class="featured-body">
          <div class="featured-meta">
            <span class="featured-date">{formatDate(data.publishedAt)}</span>
            {data.categories && data.categories.length > 0 && (
              <span class="featured-category">{data.categories.join(' / ')}</span>
            )}
          </div>
          <h2 class="featured-title">{data.title}</h2>
          <p class="featured-summary">{'description' in data ? data.description : data.summary}</p>
          <span class="featured-cta">开始阅读 <span class="arrow">→</span></span>
        </div>
      </a>
    </div>
  </div>
</section>
