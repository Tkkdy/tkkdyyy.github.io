---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/site-url';
import { PROJECT_STATUS_LABELS } from '../../lib/content/projects';
import { formatDate } from '../../lib/content/homepage';
import '../../styles/morning-radar-detail.css';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const version = '0.1.0';
const updated = data.updatedAt ? formatDate(data.updatedAt) : undefined;
const projectStatus = data.statusNote ?? PROJECT_STATUS_LABELS[data.projectStatus];

const techStack = [
  ['PY', 'Python 3.12'],
  ['PD', 'Pydantic'],
  ['J2', 'Jinja2'],
  ['DS', 'DeepSeek Provider'],
  ['HX', 'HTTPX / feedparser'],
  ['GA', 'GitHub Actions'],
  ['GP', 'GitHub Pages'],
  ['PT', 'pytest / Ruff'],
  ['JS', 'JSON / YAML'],
] as const;

const pipelineSteps = [
  ['COLLECT', '采集公开来源元数据', 'M4 5h16v14H4zM7 9h10M7 13h6'],
  ['NORMALIZE', '清洗时间、标题与链接', 'M5 7h14M5 12h14M5 17h14M9 5v4M15 10v4M11 15v4'],
  ['DEDUPE', '聚类并合并同一事件', 'M6 5v5c0 2 2 3 6 3s6 1 6 3v3M18 5v5c0 2-2 3-6 3s-6 1-6 3v3'],
  ['SCORE', '评估相关性与重要性', 'M5 18V11M10 18V7M15 18V13M20 18V4'],
  ['BRIEF', '组织可追溯中文晨报', 'M6 3h9l3 3v15H6zM9 10h6M9 14h6M9 18h4'],
  ['PUBLISH', '发布静态站点与摘要', 'M12 16V4M8 8l4-4 4 4M5 14v6h14v-6'],
] as const;

const currentStatus = [
  ['✓', '定时与手动 GitHub Actions 已接通', false],
  ['✓', '可生成首页、归档页和单日页', false],
  ['✓', 'Pages 成功后再发送微信摘要', false],
  ['○', '继续收紧 Radar 范围与倾向形成规则', true],
] as const;

const principles = [
  '少而重要，热度不等于重要性。',
  '同一事件只展示一次，多来源合并为证据。',
  '事实、分析、观点和不确定性明确分开。',
  '证据不足时，不生成趋势或方向判断。',
] as const;

const notes = [
  ['PRODUCT', 'docs/PRODUCT.md'],
  ['ARCHITECTURE', 'docs/ARCHITECTURE.md'],
  ['SOURCES', 'docs/SOURCE_GUIDE.md'],
  ['REGISTRY', 'config/sources.yaml'],
] as const;

const activity = [
  ['2026-08-17', '收紧 Radar 范围与 tendency formation 规则。', '7e9137c'],
  ['2026-08-16', '加入 practitioner signals 与 tendency intelligence。', '5515253'],
  ['2026-08-15', '生成当日 Morning Radar，并记录通知幂等状态。', '7bdcb47'],
] as const;
---

<a class="skip-link" href="#morning-radar-detail">跳至项目内容</a>

<article
  id="morning-radar-detail"
  class="morning-radar-detail project-shell"
  data-morning-radar-detail
>
  <a class="back-link" href={withBase('projects/')}>
    <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M10.5 3.5 6 8l4.5 4.5M6.5 8H14"></path></svg>
    ALL PROJECTS
  </a>

  <section class="identity" aria-labelledby="project-title">
    <div class="identity-copy">
      <h1 id="project-title">{data.name}</h1>
      <p class="identity-tagline">{data.tagline}</p>
      <p class="identity-descriptor">
        A traceable personal AI, market, and developer ecosystem morning brief.
      </p>
      <p class="identity-description">{data.description}</p>
    </div>

    <div class="identity-side">
      <div class="identity-classification">
        <span>PERSONAL INTELLIGENCE</span>
        <span>v{version}</span>
      </div>
      <dl class="metadata-panel">
        <div>
          <dt>STATUS</dt>
          <dd><span class="status-dot" aria-hidden="true"></span>{projectStatus}</dd>
        </div>
        {updated && (
          <div>
            <dt>UPDATED</dt>
            <dd><time datetime={updated}>{updated}</time></dd>
          </div>
        )}
        {data.githubUrl && (
          <div>
            <dt>LINKS</dt>
            <dd>
              <a href={data.githubUrl.toString()} target="_blank" rel="noopener noreferrer">
                GITHUB
                <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5 11 11 5M6 5h5v5"></path></svg>
              </a>
            </dd>
          </div>
        )}
        <div><dt>TYPE</dt><dd>PERSONAL INTELLIGENCE BRIEF</dd></div>
        <div><dt>VERSION</dt><dd>{version}</dd></div>
      </dl>
    </div>
  </section>

  <section class="module-field" aria-label="Morning Radar 项目档案模块">
    <article class="module evidence-module" aria-labelledby="module-output">
      <header class="module-header">
        <h2 id="module-output"><span>01</span> / DAILY BRIEF OUTPUT</h2>
        <span class="module-note">REAL OUTPUT · 2026-08-15</span>
      </header>
      <button class="evidence-open" type="button" data-open-evidence aria-label="打开真实晨报截图">
        <img
          src={withBase('projects/morning-radar-2026-08-15.png')}
          alt="Morning Radar 2026 年 8 月 15 日真实晨报首屏"
          width="1440"
          height="1000"
        />
        <span class="evidence-action">
          OPEN CAPTURE
          <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 6V3h3M10 3h3v3M13 10v3h-3M6 13H3v-3"></path></svg>
        </span>
      </button>
      <footer class="evidence-caption">
        <span>STATIC DAILY PAGE</span><span>ASIA / SINGAPORE</span><span>SOURCE LINKS PRESERVED</span>
      </footer>
    </article>

    <article class="module insight-module" aria-labelledby="module-insight">
      <header class="module-header"><h2 id="module-insight"><span>02</span> / INSIGHT NOTE</h2></header>
      <div class="insight-content">
        <p class="insight-lead">不是把标题堆在一起，<br />而是把信号还原成证据。</p>
        <p>同一事件只展示一次；事实、分析和不确定性明确分开。没有足够证据时，趋势栏目可以为空。</p>
      </div>
    </article>

    <article class="module architecture-module" aria-labelledby="module-architecture">
      <header class="module-header">
        <h2 id="module-architecture"><span>03</span> / SYSTEM ARCHITECTURE</h2>
        <span class="module-note">MODULAR MONOLITH</span>
      </header>
      <div
        class="architecture-flow"
        role="img"
        aria-label="真实系统结构：公开来源进入采集与处理流水线，经验证后写入 JSON 历史，并发布静态站点与微信摘要"
      >
        <div class="architecture-node"><strong>SOURCES</strong><span>RSS / ATOM</span><span>GITHUB / HN</span><span>MARKET</span></div>
        <svg class="architecture-arrow" aria-hidden="true" viewBox="0 0 48 12"><path d="M1 6h43M39 2l5 4-5 4"></path></svg>
        <div class="architecture-node architecture-node-primary"><strong>PIPELINE</strong><span>COLLECT + NORMALIZE</span><span>DEDUPE + SCORE</span><span>TRENDS + BRIEF</span></div>
        <svg class="architecture-arrow" aria-hidden="true" viewBox="0 0 48 12"><path d="M1 6h43M39 2l5 4-5 4"></path></svg>
        <div class="architecture-node"><strong>DELIVERY</strong><span>STATIC SITE</span><span>GITHUB PAGES</span><span>WXPUSHER</span></div>
      </div>
      <div class="architecture-foundation">
        <div><span>CONFIG</span><strong>YAML</strong></div>
        <div><span>STORAGE</span><strong>ATOMIC JSON</strong></div>
        <div><span>AI GATE</span><strong>PYDANTIC VALIDATION</strong></div>
      </div>
    </article>

    <aside class="module stack-module" aria-labelledby="module-stack">
      <header class="module-header"><h2 id="module-stack"><span>04</span> / TECH STACK</h2></header>
      <ul class="stack-list">
        {techStack.map(([label, value]) => <li><span>{label}</span><strong>{value}</strong></li>)}
      </ul>
    </aside>

    <article class="module pipeline-module" aria-labelledby="module-pipeline">
      <header class="module-header">
        <h2 id="module-pipeline"><span>05</span> / SYSTEM PIPELINE</h2>
        <span class="module-note">SEQUENTIAL · FAILURE ISOLATED</span>
      </header>
      <ol class="pipeline-list">
        {pipelineSteps.map(([label, detail, iconPath]) => (
          <li>
            <span class="pipeline-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={iconPath}></path></svg></span>
            <strong>{label}</strong><small>{detail}</small>
          </li>
        ))}
      </ol>
    </article>

    <article class="module status-module" aria-labelledby="module-status">
      <header class="module-header"><h2 id="module-status"><span>06</span> / CURRENT STATUS</h2></header>
      <ul class="status-list">
        {currentStatus.map(([mark, label, active]) => (
          <li class:list={{ 'is-active': active }}><span aria-hidden="true">{mark}</span>{label}</li>
        ))}
      </ul>
    </article>

    <article class="module signal-module" aria-labelledby="module-signal" data-pagefind-ignore>
      <header class="module-header">
        <h2 id="module-signal"><span>07</span> / SIGNAL FIELD</h2>
        <span class="module-note">DECORATIVE</span>
      </header>
      <svg class="signal-visual" aria-hidden="true" viewBox="0 0 520 170" preserveAspectRatio="none">
        <defs>
          <pattern id="signal-dots" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.05" fill="currentColor"></circle></pattern>
          <mask id="signal-mask"><path d="M0 88C58 22 112 142 170 83S281 17 342 93s120 54 178-13" fill="none" stroke="white" stroke-width="58"></path></mask>
        </defs>
        <rect width="520" height="170" fill="url(#signal-dots)" mask="url(#signal-mask)"></rect>
        <path d="M0 88C58 22 112 142 170 83S281 17 342 93s120 54 178-13" fill="none" stroke="currentColor" stroke-width="1" opacity=".35"></path>
      </svg>
    </article>

    <article class="module principles-module" aria-labelledby="module-principles">
      <header class="module-header"><h2 id="module-principles"><span>08</span> / OPERATING PRINCIPLES</h2></header>
      <ul class="principles-list">{principles.map((principle) => <li>{principle}</li>)}</ul>
    </article>

    <article class="module notes-module" aria-labelledby="module-notes">
      <header class="module-header"><h2 id="module-notes"><span>09</span> / RELATED NOTES</h2></header>
      <ul class="notes-list">{notes.map(([label, path]) => <li><span>{label}</span><code>{path}</code></li>)}</ul>
    </article>

    <article class="module activity-module" aria-labelledby="module-activity">
      <header class="module-header">
        <h2 id="module-activity"><span>10</span> / RECENT ACTIVITY</h2>
        {data.githubUrl && (
          <a href={`${data.githubUrl.toString().replace(/\/$/, '')}/commits`} target="_blank" rel="noopener noreferrer">
            VIEW LOG <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
        )}
      </header>
      <ol class="activity-list">
        {activity.map(([date, summary, hash]) => (
          <li><time datetime={date}>{date}</time><p>{summary}</p><code>{hash}</code></li>
        ))}
      </ol>
    </article>
  </section>

  <nav class="project-pagination" aria-label="项目导航" data-pagefind-ignore>
    <span class="project-disabled"><span>PREV PROJECT</span><strong>—</strong></span>
    <a href={withBase('projects/')} class="grid-link">
      <svg aria-hidden="true" viewBox="0 0 18 18"><rect x="2" y="2" width="5" height="5"></rect><rect x="11" y="2" width="5" height="5"></rect><rect x="2" y="11" width="5" height="5"></rect><rect x="11" y="11" width="5" height="5"></rect></svg>
      ALL PROJECTS
    </a>
    <a href={withBase('projects/girlfriend-desktop-pet/')} class="next-link">
      <span>NEXT PROJECT</span><strong>Girlfriend Desktop Pet</strong>
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
    </a>
  </nav>
</article>

<dialog class="evidence-dialog" data-evidence-dialog aria-labelledby="evidence-dialog-title">
  <div class="dialog-toolbar">
    <div><strong id="evidence-dialog-title">DAILY BRIEF OUTPUT</strong><span>REAL CAPTURE · 2026-08-15</span></div>
    <button type="button" data-close-evidence aria-label="关闭截图">CLOSE ×</button>
  </div>
  <img src={withBase('projects/morning-radar-2026-08-15.png')} alt="Morning Radar 真实晨报完整截图" width="1440" height="1000" />
</dialog>

<script>
  const detail = document.querySelector('[data-morning-radar-detail]');
  const dialog = document.querySelector('[data-evidence-dialog]');
  const openButton = detail?.querySelector('[data-open-evidence]');
  const closeButton = dialog?.querySelector('[data-close-evidence]');

  if (dialog instanceof HTMLDialogElement && openButton instanceof HTMLButtonElement) {
    openButton.addEventListener('click', () => dialog.showModal());
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => openButton.focus());
  }
</script>
