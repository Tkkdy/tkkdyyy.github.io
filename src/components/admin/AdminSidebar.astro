---
import AdminIcon from './AdminIcon.astro';
import type { EditorialStory } from '../../lib/admin/stories';

interface Props {
  active?: 'stories' | 'media' | 'projects' | 'homepage' | 'taxonomy' | 'site' | 'settings';
  stories: EditorialStory[];
}

const { active = 'stories', stories } = Astro.props;
const base = import.meta.env.BASE_URL;
const recent = stories.slice(0, 3);
const nav = [
  { id: 'stories', label: 'Stories', icon: 'stories', href: `${base}admin/stories/` },
  { id: 'media', label: 'Media', icon: 'media' },
  { id: 'projects', label: 'Projects', icon: 'projects' },
  { id: 'homepage', label: 'Homepage', icon: 'home' },
  { id: 'taxonomy', label: 'Taxonomy', icon: 'tag' },
  { id: 'site', label: 'Site', icon: 'globe', href: base },
  { id: 'settings', label: 'Settings', icon: 'settings' },
] as const;
---

<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-brand">
    <span class="admin-brand-mark">V</span>
    <span>VDVXDV Editorial</span>
  </div>

  <a class="new-story-button" href={`${base}admin/stories/new/`}>
    <AdminIcon name="plus" size={17} />
    <span>New Story</span>
  </a>

  <nav class="admin-nav" aria-label="Editorial Studio">
    {nav.map((item) => 'href' in item ? (
      <a class:list={['admin-nav-item', { active: active === item.id }]} href={item.href}>
        <AdminIcon name={item.icon} size={17} />
        <span>{item.label}</span>
      </a>
    ) : (
      <button class="admin-nav-item" type="button" data-coming-soon={item.label}>
        <AdminIcon name={item.icon} size={17} />
        <span>{item.label}</span>
      </button>
    ))}
  </nav>

  <div class="sidebar-spacer"></div>

  <section class="sidebar-drafts" aria-labelledby="sidebar-drafts-title">
    <div class="sidebar-section-heading">
      <h2 id="sidebar-drafts-title">Recent</h2>
      <a href={`${base}admin/stories/`}>View all</a>
    </div>
    <div class="sidebar-story-list">
      {recent.map((story, index) => (
        <a class:list={['sidebar-story', { current: index === 0 }]} href={`${base}admin/stories/${story.id}/`}>
          <strong>{story.title}</strong>
          <span>{story.status === 'published' ? 'Published' : 'Draft'} · {story.updatedAt}</span>
        </a>
      ))}
    </div>
  </section>

  <div class="sidebar-profile">
    <span class="profile-avatar">V</span>
    <span><strong>VDVXDV</strong><small>Personal site</small></span>
    <button type="button" aria-label="Account menu" disabled><AdminIcon name="more" size={17} /></button>
  </div>
</aside>
