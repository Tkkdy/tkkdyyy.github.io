---
import AdminIcon from './AdminIcon.astro';
import type { EditorialStory, EditorialTaxonomy } from '../../lib/admin/stories';

interface Props {
  story: EditorialStory;
  taxonomy: EditorialTaxonomy;
}

const { story, taxonomy } = Astro.props;
const base = import.meta.env.BASE_URL;
const storyJson = JSON.stringify(story);
const insertItems = [
  { type: 'paragraph', icon: '¶', label: 'Paragraph' },
  { type: 'heading', icon: 'H', label: 'Heading' },
  { type: 'quote', icon: '“', label: 'Quote' },
  { type: 'callout', icon: '◇', label: 'Callout' },
  { type: 'image', icon: '▣', label: 'Image' },
  { type: 'list', icon: '≡', label: 'List' },
  { type: 'code', icon: '</>', label: 'Code' },
  { type: 'divider', icon: '—', label: 'Divider' },
] as const;
---

<div class="editor-workspace" data-story={storyJson} data-base={base}>
  <article class="writing-canvas">
    <div class="writing-inner">
      <textarea class="story-title-input" rows="1" placeholder="Untitled story" aria-label="Story title">{story.title}</textarea>
      <textarea class="story-deck-input" rows="1" placeholder="Add a deck…" aria-label="Story deck">{story.deck}</textarea>

      <div class="editor-rule"></div>
      <div class="format-toolbar" aria-label="Block editor toolbar">
        <button class="block-style-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
          <span data-current-block>Paragraph</span><span class="toolbar-caret" aria-hidden="true"></span>
        </button>
        <div class="block-style-menu" role="menu" hidden>
          {insertItems.filter((item) => ['paragraph', 'heading', 'quote', 'callout', 'code'].includes(item.type)).map((item) => (
            <button type="button" role="menuitem" data-convert-block={item.type}>{item.label}</button>
          ))}
        </div>
        <i aria-hidden="true"></i>
        <button type="button" aria-label="Bold" data-format="bold"><strong>B</strong></button>
        <button type="button" aria-label="Italic" data-format="italic"><em>I</em></button>
        <button type="button" aria-label="Underline" data-format="underline"><span class="underline-label">U</span></button>
        <button type="button" aria-label="Add or edit link" data-format="link"><span aria-hidden="true">↗</span></button>
        <i aria-hidden="true"></i>
        <button type="button" aria-label="Move block up" data-block-action="up"><span aria-hidden="true">↑</span></button>
        <button type="button" aria-label="Move block down" data-block-action="down"><span aria-hidden="true">↓</span></button>
        <button type="button" aria-label="Delete block" data-block-action="delete"><span aria-hidden="true">×</span></button>
        <button class="image-edit-action" type="button" data-block-action="edit-image" hidden>Edit image</button>
      </div>

      <div class="block-editor-frame"><div class="story-block-editor" aria-label="Story body"></div></div>

      <div class="block-insert">
        <button class="block-insert-trigger" type="button" aria-label="Insert a block" aria-haspopup="menu" aria-expanded="false"><AdminIcon name="plus" size={17} /></button>
        <div class="block-insert-menu" role="menu" aria-label="Insert block" hidden>
          {insertItems.map((item) => (
            <button type="button" role="menuitem" data-insert-block={item.type}>
              <span aria-hidden="true">{item.icon}</span><small>{item.label}</small>
            </button>
          ))}
        </div>
      </div>

      <div class="editor-word-count"><span>0</span> words</div>
    </div>
  </article>

  <aside class="publishing-panel" aria-labelledby="publishing-title">
    <div class="publishing-card">
      <h2 id="publishing-title">Publishing</h2>
      <label class="publishing-field"><span>Status</span><select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label>
      <label class="publishing-field"><span>Type</span><select name="type"><option>Essay</option><option>Article</option><option>Fragment</option></select></label>
      <div class="publishing-field taxonomy-field" data-taxonomy="categories">
        <span>Categories</span>
        <div class="taxonomy-control">
          <div class="taxonomy-chips"></div>
          <label class="taxonomy-add"><AdminIcon name="plus" size={13} /><input list="category-options" placeholder="Add category" aria-label="Add category" /></label>
          <datalist id="category-options">{taxonomy.categories.map((item) => <option value={item}></option>)}</datalist>
        </div>
      </div>
      <div class="publishing-field taxonomy-field" data-taxonomy="tags">
        <span>Tags</span>
        <div class="taxonomy-control">
          <div class="taxonomy-chips"></div>
          <label class="taxonomy-add"><AdminIcon name="plus" size={13} /><input list="tag-options" placeholder="Add tag" aria-label="Add tag" /></label>
          <datalist id="tag-options">{taxonomy.tags.map((item) => <option value={item}></option>)}</datalist>
        </div>
      </div>
      <label class="publishing-field"><span>Date</span><span class="input-with-icon"><AdminIcon name="calendar" size={15} /><input type="date" name="publishedAt" value={story.publishedAt} /></span></label>
      <div class="publishing-divider"></div>
      <label class="toggle-field"><span>Homepage<small>Show on homepage</small></span><input type="checkbox" name="showOnHomepage" checked={story.showOnHomepage} /><i></i></label>
      <label class="toggle-field"><span>Featured<small>Mark as featured</small></span><input type="checkbox" name="featured" checked={story.featured} /><i></i></label>
      <label class="publishing-field"><span>Slug</span><input type="text" name="slug" value={story.slug} placeholder="story-slug" /></label>
      <div class="story-url"><span>URL</span><code></code></div>
    </div>
    <div class="publishing-card cover-card">
      <div class="card-heading"><h2>Cover Image</h2><label for="cover-input">Choose</label><input id="cover-input" type="file" accept="image/*" /></div>
      <div class="cover-preview">
        {story.cover ? <img src={story.cover} alt="Current story cover" /> : <><AdminIcon name="image" size={24} /><span>No cover selected</span></>}
      </div>
      <p>Recommended size: 1200 × 630</p>
    </div>
    <a class="sveltia-fallback" href={`${base}admin/sveltia.html`}>Open Sveltia fallback <AdminIcon name="external" size={14} /></a>
  </aside>

  <dialog class="image-block-dialog" aria-labelledby="image-dialog-title">
    <form method="dialog">
      <div class="image-dialog-heading">
        <div><h2 id="image-dialog-title">Insert image</h2><p>Add a local image or use a public URL.</p></div>
        <button type="button" data-image-cancel aria-label="Close image dialog"><AdminIcon name="close" size={17} /></button>
      </div>
      <label><span>Image file</span><input type="file" accept="image/*" data-image-file /></label>
      <div class="image-dialog-or"><span>or</span></div>
      <label><span>Image URL</span><input type="url" inputmode="url" placeholder="https://example.com/image.jpg" data-image-url /></label>
      <label><span>Alt text</span><input type="text" placeholder="Describe the image" data-image-alt /></label>
      <p class="image-dialog-error" role="alert" hidden></p>
      <div class="image-dialog-actions">
        <button class="secondary-action" type="button" data-image-cancel>Cancel</button>
        <button class="primary-action" type="submit" value="save" data-image-save>Insert image</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { initializeStoryEditors } from '../../lib/admin/story-editor-client';
  initializeStoryEditors();
</script>
