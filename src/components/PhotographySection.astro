---
// Real files only. One to three photographs keep their intrinsic aspect ratios.
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site-url';
import { imageFileExists, getImageOrientation } from '../lib/content/images';
interface Props { images: CollectionEntry<'images'>[]; }
const images = Astro.props.images.filter((entry) => imageFileExists(entry.data.image)).slice(0, 3);
const positions = ['photo-main', 'photo-portrait', 'photo-square'];
---
<section class="photography">
  <div class="photo-container">
    <div class="section-header photography-header"><span>Visual Flow</span><span>影像</span></div>
    {images.length ? <div class="photo-flow" data-photo-count={images.length}>
      {images.map(({ data }, index) => <figure class:list={[positions[index], `is-${getImageOrientation(data)}`]}>
        <a class="photo-link photo-real-link group" href={withBase(`images/${data.slug}/`)}>
          <img src={withBase(data.image)} alt={data.alt} loading="lazy" decoding="async" />
        </a>
        {(data.caption || data.title) && <figcaption class="photo-caption">{data.caption ?? data.title}</figcaption>}
      </figure>)}
    </div> : <div class="photo-empty"><p>沿途的光影，慢慢收集。</p><a class="link-underline" href={withBase('images/')}>影像记录 <span aria-hidden="true">→</span></a></div>}
  </div>
</section>
