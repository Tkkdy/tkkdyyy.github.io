---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site-url';
interface Props { images: CollectionEntry<'images'>[]; }
const { images } = Astro.props;
---
<section class="photography">
  <div class="photo-container">
    <div class="section-header photography-header"><span>Visual Flow</span><a href={withBase('images/')}>影像 →</a></div>
    <div class="home-photo-flow">
      {images.map(({ data }) => <figure class="home-photo">
        <a href={withBase(`images/${data.slug}/`)}><img src={withBase(data.image)} alt={data.alt} loading="lazy" decoding="async" /></a>
        <figcaption class="photo-caption">{data.title ?? data.series ?? data.caption ?? data.location}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
