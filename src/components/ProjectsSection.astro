---
// 项目区：全宽深色带（#1C1B19）。
// 主导项目和补充卡片均来自 Content Collections（projects）。
// 状态文案与查询共用 src/lib/content/projects.ts；githubUrl 存在才显示 GitHub 入口。
import type { CollectionEntry } from 'astro:content';
import { PROJECT_STATUS_LABELS } from '../lib/content/projects';
import { withBase } from '../lib/site-url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
// 第一个项目为主导项目，其他项目显示为补充卡片。
const [mainProject, ...otherProjects] = projects;
const visual = mainProject.data.cover ?? mainProject.data.screenshots?.[0]?.src;
const visualAlt = mainProject.data.coverAlt ?? mainProject.data.screenshots?.[0]?.alt ?? mainProject.data.name;
---
<section class="projects dark-section">
  <div class="projects-inner">
    <div class="section-header projects-header">
      <span>Active Projects &amp; Experiments</span>
      <span>项目与实验</span>
    </div>

    <!-- 主导项目 -->
    <div class="project-main">
      <div class="project-visual-col">
        <a class="project-visual-link group" href={withBase(`projects/${mainProject.data.slug}/`)}>
          {visual && <img class="home-cover project-cover" src={withBase(visual)} alt={visualAlt} loading="lazy" />}

        </a>
      </div>

      <div class="project-info">
        <div class="project-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="project-status-label">{PROJECT_STATUS_LABELS[mainProject.data.projectStatus]}</span>
        </div>

        <h3 class="project-title">{mainProject.data.name}</h3>

        <p class="project-desc">{mainProject.data.description}</p>

        <div class="project-actions">
          <a class="btn-outline-inverse" href={withBase(`projects/${mainProject.data.slug}/`)}>查看项目详情</a>
          {mainProject.data.githubUrl && (
            <a
              class="btn-link-inverse"
              href={mainProject.data.githubUrl.toString()}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub <span class="external">↗</span>
            </a>
          )}
        </div>
      </div>
    </div>

    {otherProjects.length > 0 && <div class="project-slots">
      {otherProjects.map(({data}) => <article class="home-project-card">
        <p class="project-status-label">{PROJECT_STATUS_LABELS[data.projectStatus]}</p>
        <h3><a href={withBase(`projects/${data.slug}/`)}>{data.name} <span aria-hidden="true">↗</span></a></h3>
        <p>{data.description}</p>
        <div class="home-project-tech">{data.techStack?.join(' / ')}</div>
      </article>)}
    </div>}
  </div>
</section>
