---
import { siteSettings, musicSourceAvailable } from '../lib/content/site-settings';
import { withBase } from '../lib/site-url';
import '../styles/flavor.css';
const { music } = siteSettings;
const directAudio = /\.mp3(?:[?#]|$)/i.test(music.source);
---
{music.title && musicSourceAvailable && directAudio && <script is:inline>
  document.documentElement.classList.add('music-waits-for-audio');
  // If the enhanced player fails to load, restore the native card instead of hiding it forever.
  window.setTimeout(() => document.documentElement.classList.remove('music-waits-for-audio'), 20000);
</script>}
{music.title && <section class="music-card" aria-labelledby="music-title" data-music-card data-await-audio={musicSourceAvailable && directAudio ? 'true' : undefined} data-state="paused">
  <div class="music-heading">
    {musicSourceAvailable && directAudio && <button class="music-play" type="button" aria-label="播放" aria-pressed="false" data-music-toggle hidden>
      <svg class="music-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      <svg class="music-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
    </button>}
    <h2 id="music-title">{music.title}</h2>
  </div>
  {musicSourceAvailable && (directAudio ? <>
    <audio controls preload="auto" aria-label={`聆听 ${music.title}`} data-music><source src={withBase(music.source)} type="audio/mpeg" /></audio>
    <div class="music-controls" data-music-controls hidden>
      <div class="music-progress">
        <input class="music-range" type="range" min="0" max="100" step="0.1" value="0" aria-label="播放进度" aria-valuetext="0:00 / --:--" data-music-seek disabled />
        <div class="music-times" aria-hidden="true"><span data-music-elapsed>0:00</span><span data-music-duration>--:--</span></div>
      </div>
      <div class="music-volume">
        <button class="music-mute" type="button" aria-label="静音" aria-pressed="false" data-music-mute>
          <svg class="music-icon-volume" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4 6 8H3v8h3l5 4V4Z" /><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></svg>
          <svg class="music-icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4 6 8H3v8h3l5 4V4Zm5 5 5 6m0-6-5 6" /></svg>
        </button>
        <input class="music-range" type="range" min="0" max="100" step="1" value="35" aria-label="音量" aria-valuetext="35%" data-music-volume />
        <output data-music-volume-label aria-hidden="true">35%</output>
      </div>
    </div>
    <p class="music-state" role="status" data-music-state>点击播放，听一会儿。</p>
  </> : <a class="music-listen" href={music.source} target="_blank" rel="noopener noreferrer" aria-label={`聆听 ${music.title}`}>聆听 <span aria-hidden="true">↗</span></a>)}
</section>}
<script>
  import '../lib/music-client';
</script>
