"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>VDVXDV Essays Visual Prototype (Phase 1-3)</title>\n  \n  <!-- Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Serif+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n  \n  <style>\n    /* ============================================================\n     * GLOBAL TOKENS (Simulated from existing system)\n     * ============================================================ */\n    :root {\n      /* Shared VDVXDV Palette */\n      --color-canvas: #F7F5EF; /* Warm white base */\n      --color-canvas-soft: #F3F0E8;\n      --color-ink: #191918;\n      --color-ink-soft: #46443F;\n      --color-ink-muted: #77736B;\n      --color-rule: rgba(25, 25, 24, 0.12);\n      \n      /* Typography */\n      --font-sans: 'Inter', system-ui, -apple-system, sans-serif;\n      --font-serif: 'Noto Serif SC', serif;\n      --font-mono: 'JetBrains Mono', monospace;\n\n      /* UI Control Variables */\n      --header-height: 64px;\n    }\n\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    \n    body {\n      font-family: var(--font-sans);\n      background-color: var(--color-canvas);\n      color: var(--color-ink);\n      -webkit-font-smoothing: antialiased;\n      overflow-x: hidden;\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n    }\n\n    a { text-decoration: none; color: inherit; }\n    button { background: none; border: none; cursor: pointer; font: inherit; }\n\n    /* ============================================================\n     * PROTOTYPE UI (Do not port to production)\n     * ============================================================ */\n    #prototype-controls {\n      position: fixed; top: 0; left: 0; width: 100%; height: var(--header-height);\n      background: rgba(247, 245, 239, 0.85); backdrop-filter: blur(12px);\n      border-bottom: 1px solid var(--color-rule); z-index: 1000;\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 0 24px; font-family: var(--font-mono); font-size: 12px;\n    }\n    .ctrl-group { display: flex; gap: 16px; align-items: center; }\n    .ctrl-btn {\n      padding: 6px 12px; border: 1px solid var(--color-rule); border-radius: 4px;\n      color: var(--color-ink-soft); transition: all 0.2s;\n    }\n    .ctrl-btn.active { background: var(--color-ink); color: var(--color-canvas); border-color: var(--color-ink); }\n    .ctrl-btn:hover:not(.active) { color: var(--color-ink); border-color: var(--color-ink-soft); }\n    \n    /* Simulated Header (Visual only) */\n    .simulated-header {\n      margin-top: var(--header-height);\n      padding: 24px; display: flex; gap: 32px; align-items: center;\n      font-family: var(--font-sans); font-size: 13px; font-weight: 500;\n      border-bottom: 1px solid transparent; /* Replaced by specific dir rules */\n    }\n    .simulated-header .logo { font-size: 16px; font-weight: 500; letter-spacing: -0.02em; }\n    .simulated-header .nav-links { display: flex; gap: 24px; color: var(--color-ink-muted); }\n    .simulated-header .nav-links span.active { color: var(--color-ink); }\n    \n    .simulated-footer {\n      margin-top: auto; padding: 64px 24px 32px;\n      font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted);\n      border-top: 1px solid var(--color-rule); text-align: center;\n    }\n\n    main { flex-grow: 1; width: 100%; }\n\n    /* ============================================================\n     * CSS TONAL BLOCKS (Simulating Photography)\n     * ============================================================ */\n    .css-photo {\n      background-color: #E2DDD5;\n      display: flex; align-items: center; justify-content: center;\n      overflow: hidden; position: relative; width: 100%;\n    }\n    .css-photo-text {\n      font-family: var(--font-mono); font-size: 10px; color: rgba(25,25,24,0.4);\n      text-transform: uppercase; letter-spacing: 0.1em;\n    }\n    .photo-landscape { aspect-ratio: 16/9; background-color: #D6D8D4; }\n    .photo-wide { aspect-ratio: 21/9; background-color: #DCD9D4; }\n    .photo-portrait { aspect-ratio: 3/4; background-color: #DFD7D1; }\n    .photo-square { aspect-ratio: 1/1; background-color: #D3D5D7; }\n\n    /* ============================================================\n     * DIRECTION A: THE EDITORIAL GALLERY\n     * ============================================================ */\n    /* Index A */\n    .dir-A .index-view {\n      max-width: 1200px; margin: 0 auto; padding: 64px 24px;\n    }\n    .dir-A .index-header {\n      margin-bottom: 80px; text-align: center;\n    }\n    .dir-A .index-title {\n      font-family: var(--font-serif); font-size: 40px; font-weight: 400; letter-spacing: -0.02em;\n    }\n    .dir-A .essay-grid {\n      display: grid; grid-template-columns: repeat(12, 1fr); gap: 64px 24px;\n    }\n    .dir-A .essay-card {\n      display: flex; flex-direction: column; group; cursor: pointer;\n    }\n    .dir-A .essay-card .css-photo {\n      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    .dir-A .essay-card:hover .css-photo { transform: scale(1.02); }\n    \n    /* Card Variants in A */\n    .dir-A .card-featured { grid-column: span 12; display: grid; grid-template-columns: repeat(12, 1fr); gap: 48px; align-items: center;}\n    .dir-A .card-featured .img-wrap { grid-column: span 8; overflow: hidden; }\n    .dir-A .card-featured .text-wrap { grid-column: span 4; }\n    \n    .dir-A .card-standard { grid-column: span 4; }\n    .dir-A .card-portrait { grid-column: span 4; }\n    .dir-A .card-nocover { grid-column: span 8; padding: 48px; border: 1px solid var(--color-rule); display: flex; flex-direction: column; justify-content: center;}\n    .dir-A .card-textonly { grid-column: span 12; border-top: 1px solid var(--color-rule); padding-top: 24px; display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; }\n    \n    .dir-A .e-date { font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); margin-bottom: 16px; display: block; }\n    .dir-A .e-title { font-family: var(--font-serif); font-size: 24px; font-weight: 500; line-height: 1.3; margin-bottom: 12px; transition: color 0.2s; }\n    .dir-A .card-featured .e-title { font-size: 36px; }\n    .dir-A .card-nocover .e-title { font-size: 32px; }\n    .dir-A .card-textonly .e-title { grid-column: span 4; font-size: 20px; }\n    .dir-A .card-textonly .e-summary { grid-column: span 6; }\n    .dir-A .card-textonly .e-date { grid-column: span 2; margin-bottom: 0; }\n    \n    .dir-A .e-summary { font-size: 14px; line-height: 1.6; color: var(--color-ink-soft); }\n    .dir-A .img-wrap { margin-bottom: 24px; overflow: hidden; }\n\n    /* Detail A */\n    .dir-A .detail-view { padding-bottom: 128px; }\n    .dir-A .detail-header {\n      max-width: 960px; margin: 80px auto 64px; padding: 0 24px; text-align: center;\n    }\n    .dir-A .detail-title { font-family: var(--font-serif); font-size: 48px; font-weight: 500; line-height: 1.2; margin-bottom: 24px; }\n    .dir-A .detail-meta { font-family: var(--font-mono); font-size: 12px; color: var(--color-ink-muted); display: flex; justify-content: center; gap: 24px; }\n    .dir-A .prose { max-width: 680px; margin: 0 auto; padding: 0 24px; font-family: var(--font-serif); font-size: 18px; line-height: 1.9; color: var(--color-ink); }\n    .dir-A .prose p { margin-bottom: 2em; }\n    \n    /* Essay-specific prose extensions */\n    .dir-A .essay-figure { margin: 4em 0; }\n    .dir-A .essay-figure.wide { width: 100vw; max-width: 1200px; margin-left: 50%; transform: translateX(-50%); }\n    .dir-A .essay-figure.portrait { width: 60%; margin: 4em auto; }\n    .dir-A .essay-figure.composition { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; width: 120%; margin-left: -10%; }\n    .dir-A .essay-caption { font-family: var(--font-sans); font-size: 12px; color: var(--color-ink-muted); margin-top: 12px; display: block; }\n\n\n    /* ============================================================\n     * DIRECTION B: THE QUIET JOURNAL\n     * ============================================================ */\n    /* Index B */\n    .dir-B .index-view { max-width: 800px; margin: 0 auto; padding: 80px 24px; }\n    .dir-B .index-header { margin-bottom: 64px; border-bottom: 1px solid var(--color-rule); padding-bottom: 24px; }\n    .dir-B .index-title { font-family: var(--font-serif); font-size: 24px; font-weight: 500; }\n    .dir-B .essay-list { display: flex; flex-direction: column; gap: 48px; }\n    .dir-B .essay-row { display: flex; gap: 48px; cursor: pointer; align-items: flex-start; group; }\n    \n    .dir-B .e-date { width: 100px; flex-shrink: 0; font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); padding-top: 6px; transition: color 0.3s;}\n    .dir-B .essay-row:hover .e-date { color: var(--color-ink); }\n    .dir-B .e-content { flex-grow: 1; display: flex; gap: 32px; justify-content: space-between;}\n    .dir-B .e-text { max-width: 400px; }\n    .dir-B .e-title { font-family: var(--font-serif); font-size: 20px; font-weight: 500; line-height: 1.4; margin-bottom: 12px; }\n    .dir-B .e-summary { font-size: 14px; line-height: 1.7; color: var(--color-ink-soft); }\n    \n    .dir-B .e-inset-img { width: 120px; flex-shrink: 0; filter: grayscale(20%); transition: filter 0.3s; }\n    .dir-B .essay-row:hover .e-inset-img { filter: grayscale(0%); }\n\n    /* Detail B */\n    .dir-B .detail-view { padding-bottom: 128px; }\n    .dir-B .detail-header { max-width: 640px; margin: 80px auto 48px; padding: 0 24px; }\n    .dir-B .detail-meta { font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); margin-bottom: 24px; }\n    .dir-B .detail-title { font-family: var(--font-serif); font-size: 32px; font-weight: 500; line-height: 1.35; margin-bottom: 32px; }\n    \n    .dir-B .prose { max-width: 640px; margin: 0 auto; padding: 0 24px; font-family: var(--font-serif); font-size: 17px; line-height: 1.9; color: var(--color-ink-soft); }\n    .dir-B .prose p { margin-bottom: 2em; }\n    \n    /* Quiet Image Rules */\n    .dir-B .essay-figure { margin: 3em 0; }\n    .dir-B .essay-figure.wide { width: 100%; } /* No breaking out in B */\n    .dir-B .essay-figure.portrait { width: 50%; float: right; margin: 0 0 2em 2em; }\n    .dir-B .essay-figure.composition { display: flex; flex-direction: column; gap: 16px; } /* Stacked instead of grid for quietness */\n    .dir-B .essay-caption { font-family: var(--font-sans); font-size: 11px; color: var(--color-ink-muted); margin-top: 8px; border-left: 1px solid var(--color-rule); padding-left: 12px; }\n\n\n    /* ============================================================\n     * DIRECTION C: THE STAGGERED CANVAS\n     * ============================================================ */\n    /* Index C */\n    .dir-C .index-view { max-width: 1440px; margin: 0 auto; padding: 48px 48px; }\n    .dir-C .index-header { margin-bottom: 48px; }\n    .dir-C .index-title { font-family: var(--font-sans); font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }\n    \n    .dir-C .masonry-grid { column-count: 2; column-gap: 48px; }\n    .dir-C .essay-block { break-inside: avoid; margin-bottom: 64px; cursor: pointer; transition: opacity 0.3s; }\n    .dir-C .masonry-grid:hover .essay-block:not(:hover) { opacity: 0.6; }\n    \n    .dir-C .img-wrap { margin-bottom: 16px; border-radius: 2px; overflow: hidden; }\n    .dir-C .e-meta-row { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); margin-bottom: 12px; }\n    .dir-C .e-title { font-family: var(--font-serif); font-size: 22px; font-weight: 500; line-height: 1.35; margin-bottom: 12px; }\n    .dir-C .e-summary { font-size: 14px; line-height: 1.6; color: var(--color-ink-soft); }\n    \n    .dir-C .block-nocover { padding: 48px; background-color: rgba(25,25,24,0.03); border-radius: 2px; }\n    .dir-C .block-nocover .e-title { font-size: 28px; }\n\n    /* Detail C */\n    .dir-C .detail-view { padding-bottom: 128px; }\n    .dir-C .detail-header { max-width: 1000px; margin: 80px auto 64px; padding: 0 48px; display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: end;}\n    .dir-C .detail-meta { font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-muted); display: flex; flex-direction: column; gap: 8px;}\n    .dir-C .detail-title { font-family: var(--font-serif); font-size: 40px; font-weight: 500; line-height: 1.2; }\n    \n    .dir-C .prose-container { max-width: 1000px; margin: 0 auto; padding: 0 48px; display: grid; grid-template-columns: 1fr; gap: 48px; }\n    .dir-C .prose { font-family: var(--font-serif); font-size: 17px; line-height: 1.8; color: var(--color-ink); max-width: 600px; margin: 0 auto;}\n    .dir-C .prose p { margin-bottom: 2em; }\n    \n    /* Fluid Image Rules */\n    .dir-C .essay-figure { margin: 4em 0; position: relative; }\n    .dir-C .essay-figure.wide { width: calc(100% + 120px); margin-left: -60px; }\n    .dir-C .essay-figure.portrait { width: 50%; }\n    .dir-C .essay-figure.composition { display: grid; grid-template-columns: 2fr 3fr; gap: 16px; align-items: end; }\n    .dir-C .essay-caption { position: absolute; bottom: -24px; right: 0; font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-muted); text-transform: uppercase;}\n    .dir-C .composition .essay-caption { position: static; margin-top: 12px; text-align: right; }\n\n    /* ============================================================\n     * RESPONSIVE ADJUSTMENTS\n     * ============================================================ */\n    @media (max-width: 1024px) {\n      .dir-A .card-featured { grid-template-columns: 1fr; }\n      .dir-A .card-featured .img-wrap, .dir-A .card-featured .text-wrap { grid-column: span 12; }\n      .dir-A .essay-figure.composition { width: 100%; margin-left: 0; }\n      .dir-C .detail-header { grid-template-columns: 1fr; gap: 24px; align-items: start; }\n    }\n\n    @media (max-width: 768px) {\n      #prototype-controls { flex-wrap: wrap; height: auto; padding: 12px; gap: 12px; justify-content: center;}\n      .simulated-header { margin-top: 100px; padding: 16px; }\n      \n      /* A Mobile */\n      .dir-A .essay-grid { grid-template-columns: 1fr; gap: 48px; }\n      .dir-A .card-standard, .dir-A .card-portrait, .dir-A .card-nocover, .dir-A .card-textonly { grid-column: span 1; }\n      .dir-A .card-textonly { grid-template-columns: 1fr; gap: 12px; }\n      .dir-A .card-textonly .e-title, .dir-A .card-textonly .e-summary, .dir-A .card-textonly .e-date { grid-column: span 1; }\n      .dir-A .essay-figure.wide { width: 100vw; margin-left: -24px; }\n      \n      /* B Mobile */\n      .dir-B .essay-row { flex-direction: column; gap: 16px; }\n      .dir-B .e-date { width: auto; padding-top: 0; }\n      .dir-B .e-content { flex-direction: column; gap: 16px; }\n      .dir-B .e-inset-img { width: 100%; height: auto; max-width: 240px; }\n      .dir-B .essay-figure.portrait { width: 100%; float: none; margin: 2em 0; }\n      \n      /* C Mobile */\n      .dir-C .masonry-grid { column-count: 1; }\n      .dir-C .index-view, .dir-C .detail-header, .dir-C .prose-container { padding: 24px; }\n      .dir-C .essay-figure.wide { width: 100%; margin-left: 0; }\n      .dir-C .essay-figure.composition { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body class=\"dir-A\" id=\"body\">\n\n  <!-- Controls (Not part of design) -->\n  <div id=\"prototype-controls\">\n    <div class=\"ctrl-group\">\n      <strong>Direction:</strong>\n      <button class=\"ctrl-btn active\" onclick=\"setDir('A')\">A: Editorial Gallery</button>\n      <button class=\"ctrl-btn\" onclick=\"setDir('B')\">B: Quiet Journal</button>\n      <button class=\"ctrl-btn\" onclick=\"setDir('C')\">C: Staggered Canvas</button>\n    </div>\n    <div class=\"ctrl-group\">\n      <strong>View:</strong>\n      <button class=\"ctrl-btn active\" id=\"btn-index\" onclick=\"setView('index')\">Index (/essays)</button>\n      <button class=\"ctrl-btn\" id=\"btn-detail\" onclick=\"setView('detail')\">Detail (/essays/[slug])</button>\n    </div>\n  </div>\n\n  <header class=\"simulated-header\">\n    <div class=\"logo\">VDVXDV</div>\n    <div class=\"nav-links\">\n      <span>项目</span>\n      <span class=\"active\">随笔</span>\n      <span>文章</span>\n      <span>影像</span>\n    </div>\n  </header>\n\n  <main id=\"main-content\">\n    <!-- Rendered by JS -->\n  </main>\n\n  <footer class=\"simulated-footer\">\n    © 2026 VDVXDV. Not all who wander are lost.\n  </footer>\n\n  <script>\n    // --- Data Fixtures ---\n    // 1 真实标题; 2 长中文标题; 3 大横图; 4 竖图; 5 无 cover; 6 无 summary; 7 长 archive\n    const fixtures = [\n      {\n        id: 'f1',\n        title: '初中时，我只是想看 YouTube',\n        summary: '我最初只是想看一些游戏实况。后来却莫名其妙地搭建起了自己的整个互联网世界。',\n        date: '2026-08-01',\n        tags: ['互联网', '回忆'],\n        coverType: 'landscape', // 16:9\n        type: 'featured'\n      },\n      {\n        id: 'f2',\n        title: '当我们在谈论上下文的时候，我们实际上在记录自己如何成为自己',\n        summary: '一段关于记忆外包的随想。工具会消失，但积累过的判断和经历仍然可以继续复用。',\n        date: '2026-07-28',\n        tags: ['AI', '思考'],\n        coverType: null, // No cover\n        type: 'nocover'\n      },\n      {\n        id: 'f3',\n        title: '雨落下来以前的蓝色时刻',\n        summary: '空气突然安静了一会，远处的建筑边缘在低照度下显得异常清晰。',\n        date: '2026-07-15',\n        tags: ['城市', '傍晚'],\n        coverType: 'wide', // 21:9\n        type: 'standard'\n      },\n      {\n        id: 'f4',\n        title: '深夜散步与边界线',\n        summary: null, // No summary\n        date: '2026-06-30',\n        tags: ['城市'],\n        coverType: 'portrait', // 3:4\n        type: 'portrait'\n      },\n      {\n        id: 'f5',\n        title: '工具的尽头',\n        summary: '过度优化个人工作流，往往是逃避真正困难工作的表现。',\n        date: '2026-05-12',\n        tags: ['观察'],\n        coverType: null,\n        type: 'textonly'\n      },\n      {\n        id: 'f6',\n        title: '一张旧书桌',\n        summary: '搬家时丢弃了很多东西，唯独留下了这张边缘磨损的桌子。',\n        date: '2026-04-05',\n        tags: ['生活'],\n        coverType: 'square',\n        type: 'standard'\n      },\n      {\n        id: 'f7',\n        title: '信息的半衰期',\n        summary: '我们每天摄入的内容，有多少能在三天后依然被记起？',\n        date: '2026-03-22',\n        tags: ['思考'],\n        coverType: null,\n        type: 'textonly'\n      }\n    ];\n\n    // --- State ---\n    let currentDir = 'A';\n    let currentView = 'index';\n\n    // --- DOM Elements ---\n    const body = document.getElementById('body');\n    const mainContent = document.getElementById('main-content');\n    const btnIndex = document.getElementById('btn-index');\n    const btnDetail = document.getElementById('btn-detail');\n    const dirBtns = document.querySelectorAll('.ctrl-btn[onclick^=\"setDir\"]');\n\n    // --- Render Functions ---\n    function renderPhoto(type) {\n      if (!type) return '';\n      return `\n        <div class=\"css-photo photo-${type}\">\n          <span class=\"css-photo-text\">Atmosphere Photo</span>\n        </div>\n      `;\n    }\n\n    function renderIndexA() {\n      let html = `<div class=\"index-view\"><header class=\"index-header\"><h1 class=\"index-title\">Essays</h1></header><div class=\"essay-grid\">`;\n      fixtures.forEach(f => {\n        const cardClass = f.type === 'featured' ? 'card-featured' : \n                          f.type === 'nocover' ? 'card-nocover' : \n                          f.type === 'textonly' ? 'card-textonly' : \n                          f.type === 'portrait' ? 'card-portrait' : 'card-standard';\n        \n        html += `\n          <article class=\"essay-card ${cardClass}\" onclick=\"setView('detail')\">\n            ${f.coverType ? `<div class=\"img-wrap\">${renderPhoto(f.coverType)}</div>` : ''}\n            <div class=\"text-wrap\">\n              <time class=\"e-date\">${f.date}</time>\n              <h2 class=\"e-title\">${f.title}</h2>\n              ${f.summary ? `<p class=\"e-summary\">${f.summary}</p>` : ''}\n            </div>\n          </article>\n        `;\n      });\n      html += `</div></div>`;\n      return html;\n    }\n\n    function renderIndexB() {\n      let html = `<div class=\"index-view\"><header class=\"index-header\"><h1 class=\"index-title\">Essays</h1></header><div class=\"essay-list\">`;\n      fixtures.forEach(f => {\n        html += `\n          <article class=\"essay-row\" onclick=\"setView('detail')\">\n            <time class=\"e-date\">${f.date}</time>\n            <div class=\"e-content\">\n              <div class=\"e-text\">\n                <h2 class=\"e-title\">${f.title}</h2>\n                ${f.summary ? `<p class=\"e-summary\">${f.summary}</p>` : ''}\n              </div>\n              ${f.coverType ? `<div class=\"e-inset-img\">${renderPhoto('square')}</div>` : ''}\n            </div>\n          </article>\n        `;\n      });\n      html += `</div></div>`;\n      return html;\n    }\n\n    function renderIndexC() {\n      let html = `<div class=\"index-view\"><header class=\"index-header\"><h1 class=\"index-title\">Collected Essays</h1></header><div class=\"masonry-grid\">`;\n      fixtures.forEach(f => {\n        const blockClass = f.coverType ? 'block-standard' : 'block-nocover';\n        html += `\n          <article class=\"essay-block ${blockClass}\" onclick=\"setView('detail')\">\n            ${f.coverType ? `<div class=\"img-wrap\">${renderPhoto(f.coverType)}</div>` : ''}\n            <div class=\"e-meta-row\">\n              <time>${f.date}</time>\n              <span>${f.tags.join(', ')}</span>\n            </div>\n            <h2 class=\"e-title\">${f.title}</h2>\n            ${f.summary ? `<p class=\"e-summary\">${f.summary}</p>` : ''}\n          </article>\n        `;\n      });\n      html += `</div></div>`;\n      return html;\n    }\n\n    function renderDetail() {\n      // Shared fixture for Detail demonstrating requested variations\n      return `\n        <div class=\"detail-view\">\n          <header class=\"detail-header\">\n            ${currentDir === 'C' ? `\n              <div class=\"detail-meta\">\n                <time>2026-08-01</time>\n                <span>互联网, 回忆</span>\n              </div>\n              <h1 class=\"detail-title\">初中时，我只是想看 YouTube</h1>\n            ` : `\n              <h1 class=\"detail-title\">初中时，我只是想看 YouTube</h1>\n              <div class=\"detail-meta\">\n                <time>2026-08-01</time>\n                <span>互联网, 回忆</span>\n              </div>\n            `}\n          </header>\n\n          <div class=\"prose-container\">\n            <div class=\"prose\">\n              <p>我最初只是想看一些游戏实况。那时家里的网络并不算快，屏幕上的像素常常糊成一团，但这足以让我窥见另一个世界的切片。</p>\n              \n              <!-- 1. Normal Image -->\n              <figure class=\"essay-figure normal\">\n                ${renderPhoto('landscape')}\n                <figcaption class=\"essay-caption\">旧电脑桌上的灯光</figcaption>\n              </figure>\n\n              <p>后来为了能更顺畅地访问，我开始研究各种网络工具。那是一个充满惊奇的过程，每一个新概念都像是一扇门。我学会了配置路由，学会了看懂简单的终端代码，甚至为了搭建一个代理，硬着头皮啃完了全英文的文档。</p>\n\n              <!-- 2. Wide Image -->\n              <figure class=\"essay-figure wide\">\n                ${renderPhoto('wide')}\n                <figcaption class=\"essay-caption\">凌晨两点的屏幕反光与堆满杂物的桌面</figcaption>\n              </figure>\n\n              <p>当真正的无缝访问实现时，我看着屏幕上流畅播放的高清视频，心里却产生了一种奇怪的空虚感。我发现自己其实并不那么在意游戏实况了。在这个“为了看视频而搭桥”的过程中，我其实是在构建自己的数字防线与个人基础设施。</p>\n              \n              <!-- 3. Portrait Image -->\n              <figure class=\"essay-figure portrait\">\n                ${renderPhoto('portrait')}\n                <figcaption class=\"essay-caption\">后来买的第一台属于自己的服务器</figcaption>\n              </figure>\n\n              <p>这段长正文没有图片。因为有时候，记忆本身比任何照片都要清晰。那段在昏暗房间里敲击键盘的日子，成为了我后来所有技术尝试的起点。它让我明白，很多时候，目的并不重要，重要的是你在走向那个目的的过程中，顺手建造了什么。</p>\n              <p>技术不仅仅是工具，它是一种理解世界、重塑自身环境的方式。当我在终端里敲下第一行自己真正理解的命令时，我不仅仅是在控制一台远端的机器，我是在向那个庞大、冰冷但又充满可能性的数字宇宙宣告我的存在。</p>\n\n              <!-- 4. Two-image composition -->\n              <figure class=\"essay-figure composition\">\n                ${renderPhoto('portrait')}\n                ${renderPhoto('square')}\n                <figcaption class=\"essay-caption\">早期的工作台布局与堆叠的外设</figcaption>\n              </figure>\n\n              <p>很多年后，我依然会想起那个只想看 YouTube 的下午。那是一个极其纯粹的起点，没有职业规划，没有技术焦虑，只有纯粹的好奇心驱动着一个少年去拆解世界的齿轮。</p>\n            </div>\n          </div>\n        </div>\n      `;\n    }\n\n    function updateDOM() {\n      if (currentView === 'index') {\n        if (currentDir === 'A') mainContent.innerHTML = renderIndexA();\n        if (currentDir === 'B') mainContent.innerHTML = renderIndexB();\n        if (currentDir === 'C') mainContent.innerHTML = renderIndexC();\n      } else {\n        mainContent.innerHTML = renderDetail();\n      }\n    }\n\n    // --- Event Handlers ---\n    window.setDir = function(dir) {\n      currentDir = dir;\n      body.className = `dir-${dir}`;\n      \n      dirBtns.forEach(btn => {\n        btn.classList.remove('active');\n        if (btn.innerText.includes(dir)) btn.classList.add('active');\n      });\n      \n      updateDOM();\n      window.scrollTo(0, 0);\n    }\n\n    window.setView = function(view) {\n      currentView = view;\n      btnIndex.classList.toggle('active', view === 'index');\n      btnDetail.classList.toggle('active', view === 'detail');\n      \n      updateDOM();\n      window.scrollTo(0, 0);\n    }\n\n    // Init\n    updateDOM();\n  </script>\n</body>\n</html>"