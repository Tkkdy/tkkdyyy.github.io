{
  "name": "tkkdy-personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/normalize-public-urls.mjs pages && pagefind --site dist",
    "build:astro": "astro build",
    "preview": "astro preview",
    "check": "astro check && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:vps": "astro build --config astro.config.vps.mjs && node scripts/normalize-public-urls.mjs vps && node scripts/prune-vps-admin.mjs && pagefind --site dist",
    "build:admin": "astro build --config astro.config.admin.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "^7.2.0",
    "marked": "^18.0.11",
    "parse5": "8.0.1",
    "yaml": "^2.9.0",
    "dompurify": "3.4.17",
    "graphql": "17.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "playwright": "1.64.1",
    "typescript": "^6.0.3"
  }
}
